+func (a *API) authorizedTokenSwitch(ctx context.Context, requestToken *SecureToken) bool {
+	if !a.isNotFC {
+		return false
+	}
+	if requestToken.IsSet() {
+		if a.accessToken.IsSet() && a.accessToken.EqualsSecure(requestToken) {
+			return false
+		}
+	} else if !a.accessToken.IsSet() {
+		return false
+	}
+	matches, _ := a.checkMMDSHash(ctx, requestToken)
+
+	return matches
